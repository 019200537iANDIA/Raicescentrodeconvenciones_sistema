as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526b60;fontSize=11;" edge="1" parent="1" source="n16" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526b60;fontSize=11;" edge="1" parent="1" source="n17" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526b60;fontSize=11;" edge="1" parent="1" source="n18" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="Sí: directa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526b60;fontSize=11;" edge="1" parent="1" source="n22" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="No: cotizar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526b60;fontSize=11;" edge="1" parent="1" source="n22" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note0" value="Cotización: 15 días. Sin adelanto al vencimiento, se cierra la oportunidad y se libera la fecha. Adelanto: 10–30 %." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6a800;fontSize=12;" vertex="1" parent="1"><mxGeometry x="55" y="1005" width="470" height="125" as="geometry"/></mxCell><mxCell id="note1" value="V1 reemplaza el generador HTML. Reportes son transversales; turnos, reemplazos, horas y pagos del personal pasan a una versión futura." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6a800;fontSize=12;" vertex="1" parent="1"><mxGeometry x="565" y="1005" width="470" height="125" as="geometry"/></mxCell><mxCell id="note2" value="V1: una reserva por fecha. La división del salón no permite todavía dos eventos simultáneos; queda como ampliación futura." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6a800;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1075" y="1005" width="470" height="125" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>