<mxfile host="app.diagrams.net" modified="2026-11-15T00:00:00.000Z" agent="Codex" version="24.7.17"><diagram id="Modelo_datos_Raices_04_Fase_Posterior.drawio" name="Modelo de datos · fase posterior"><mxGraphModel dx="1600" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="f_title" value="&lt;b&gt;MODELO LÓGICO · EXTENSIONES POSTERIORES&lt;/b&gt;&lt;br&gt;Entidades previstas si se aprueba la ampliación del alcance" style="text;html=1;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#2c5f4a;" vertex="1" parent="1"><mxGeometry x="390" y="25" width="950" height="55" as="geometry"/></mxCell><mxCell id="i_item" value="&lt;b&gt;ARTÍCULO DE INVENTARIO&lt;/b&gt;&lt;br&gt;PK artículo_id · nombre/categoría&lt;br&gt;color · modelo · unidad · stock actual&lt;br&gt;mueble/mesa/silla/cristalería/tela/flor" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="45" y="150" width="300" height="160" as="geometry"/></mxCell><mxCell id="i_move" value="&lt;b&gt;MOVIMIENTO DE INVENTARIO&lt;/b&gt;&lt;br&gt;PK movimiento_id · FK artículo_id/evento_id&lt;br&gt;tipo: salida/devolución/daño/pérdida&lt;br&gt;cantidad · fecha · responsable&lt;br&gt;cargo/observación · estado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="150" width="300" height="165" as="geometry"/></mxCell><mxCell id="g_service" value="&lt;b&gt;SERVICIO / PAQUETE&lt;/b&gt;&lt;br&gt;PK servicio_id · nombre/categoría&lt;br&gt;descripción · público/activo" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="150" width="300" height="135" as="geometry"/></mxCell><mxCell id="g_photo" value="&lt;b&gt;FOTO DE GALERÍA&lt;/b&gt;&lt;br&gt;PK foto_id · FK servicio_id&lt;br&gt;archivo/ruta · descripción · orden&lt;br&gt;autorización de uso · activo" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1230" y="150" width="300" height="150" as="geometry"/></mxCell><mxCell id="s_person" value="&lt;b&gt;PERSONAL&lt;/b&gt;&lt;br&gt;PK personal_id · datos mínimos&lt;br&gt;contacto / función / activo" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="45" y="470" width="300" height="130" as="geometry"/></mxCell><mxCell id="s_shift" value="&lt;b&gt;TURNO / REEMPLAZO&lt;/b&gt;&lt;br&gt;PK turno_id · FK evento_id/personal_id&lt;br&gt;inicio/fin · función · horas&lt;br&gt;reemplaza_turno_id · estado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="470" width="300" height="160" as="geometry"/></mxCell><mxCell id="s_settlement" value="&lt;b&gt;PAGO DE PERSONAL&lt;/b&gt;&lt;br&gt;PK liquidación_id · FK turno_id&lt;br&gt;importe/hora · total · adelantos&lt;br&gt;pagado_en · método · comprobante" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="470" width="300" height="155" as="geometry"/></mxCell><mxCell id="fr1" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="i_item" target="i_move"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fr2" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="g_service" target="g_photo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fr3" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="s_person" target="s_shift"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fr4" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="s_shift" target="s_settlement"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f_note" value="&lt;b&gt;NOTA&lt;/b&gt;&lt;br&gt;La gerente solicita horarios, turnos, reemplazos, horas, pagos y adelantos con prioridad alta; la priorización inicial de propietario/gerente dice que el control horario se posterga (el propietario también lo pospone). Este módulo queda diseñado como extensión hasta que ambos acuerden alcance y responsable." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6a800;fontSize=11;" vertex="1" parent="1"><mxGeometry x="45" y="760" width="790" height="110" as="geometry"/></mxCell><mxCell id="f_note2" value="&lt;b&gt;NOTA&lt;/b&gt;&lt;br&gt;La galería de servicios fue solicitada como idea y el inventario como necesidad, pero ambos pueden quedar fuera de v1. Las entidades se muestran como diseño futuro; no asumir que ya son requisitos aprobados." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6a800;fontSize=11;" vertex="1" parent="1"><mxGeometry x="875" y="760" width="790" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>