<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Raices" targetNamespace="https://uandina.edu.pe/raices/bpmn">
 <bpmn:process id="Process_Raices" name="Proceso propuesto integrado de consulta, cotización y reserva" isExecutable="false">
  <bpmn:laneSet id="LaneSet_1"><bpmn:lane id="Lane_Internal" name="Sistema integrado — usuario interno"><bpmn:flowNodeRef>Start_Consulta</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Lead</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Cal</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Fecha</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Alternativa</bpmn:flowNodeRef><bpmn:flowNodeRef>End_NoFecha</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConfigQuote</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_DirectStart</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Price</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Send</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Followup</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Contact</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Race</bpmn:flowNodeRef><bpmn:flowNodeRef>Catch_Response</bpmn:flowNodeRef><bpmn:flowNodeRef>Catch_Expiry</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Accept</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Expire</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Expire</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Deposit</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Reserve</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Contract</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Cancel</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Coord</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Change</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Change</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Evento</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Cancel</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Cancel</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
  <bpmn:startEvent id="Start_Consulta" name="Llega una consulta"><bpmn:outgoing>T01</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="Task_Lead" name="Registrar/actualizar cliente, canal y oportunidad"><bpmn:incoming>T01</bpmn:incoming><bpmn:outgoing>T02</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="Task_Cal" name="Consultar disponibilidad; una reserva por fecha en v1"><bpmn:incoming>T02</bpmn:incoming><bpmn:incoming>T05</bpmn:incoming><bpmn:outgoing>T03</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="Gateway_Fecha" name="¿Fecha disponible?"><bpmn:incoming>T03</bpmn:incoming><bpmn:outgoing>T04</bpmn:outgoing><bpmn:outgoing>T06</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="Task_Alternativa" name="Proponer fecha alternativa y volver a consultar"><bpmn:incoming>T04</bpmn:incoming><bpmn:outgoing>T05</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="End_NoFecha" name="Sin fecha acordada"></bpmn:endEvent>
<bpmn:userTask id="Task_ConfigQuote" name="Configurar evento, asistentes, paquete y servicios"><bpmn:incoming>T06a</bpmn:incoming><bpmn:outgoing>T07</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="Gateway_DirectStart" name="¿Reserva directa?"><bpmn:incoming>T06</bpmn:incoming><bpmn:outgoing>T06a</bpmn:outgoing><bpmn:outgoing>T06b</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="Task_Price" name="Calcular precio editable y generar cotización PDF"><bpmn:incoming>T07</bpmn:incoming><bpmn:outgoing>T08</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="Task_Send" name="Enviar cotización; mostrar cantidad y total/persona"><bpmn:incoming>T08</bpmn:incoming><bpmn:outgoing>T09</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="Task_Followup" name="Programar contacto a 2–3 días y segundo contacto si hace falta"><bpmn:incoming>T09</bpmn:incoming><bpmn:outgoing>T10</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="Task_Contact" name="Contactar al cliente y registrar respuesta"><bpmn:incoming>T10</bpmn:incoming><bpmn:outgoing>T10a</bpmn:outgoing></bpmn:userTask>
<bpmn:eventBasedGateway id="Gateway_Race" name="Esperar respuesta o vencimiento configurado"><bpmn:incoming>T10a</bpmn:incoming><bpmn:outgoing>T11</bpmn:outgoing><bpmn:outgoing>T12</bpmn:outgoing></bpmn:eventBasedGateway>
<bpmn:intermediateCatchEvent id="Catch_Response" name="Cliente responde"><bpmn:incoming>T11</bpmn:incoming><bpmn:outgoing>T15</bpmn:outgoing></bpmn:intermediateCatchEvent>
<bpmn:intermediateCatchEvent id="Catch_Expiry" name="Vence cotización a los 15 días"><bpmn:incoming>T12</bpmn:incoming><bpmn:outgoing>T13</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P15D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
<bpmn:exclusiveGateway id="Gateway_Accept" name="¿Acepta la propuesta?"><bpmn:incoming>T15</bpmn:incoming><bpmn:outgoing>T16</bpmn:outgoing><bpmn:outgoing>T17</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="Task_Expire" name="Cerrar oportunidad y liberar fecha si no pagó adelanto"><bpmn:incoming>T13</bpmn:incoming><bpmn:outgoing>T14</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="End_Expire" name="Oportunidad cerrada"><bpmn:incoming>T14</bpmn:incoming><bpmn:incoming>T17</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="Task_Deposit" name="Registrar adelanto acordado entre 10 % y 30 %"><bpmn:incoming>T06b</bpmn:incoming><bpmn:incoming>T16</bpmn:incoming><bpmn:outgoing>T18</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="Task_Reserve" name="Registrar reserva y bloquear fecha (máximo 1 por fecha)"><bpmn:incoming>T18</bpmn:incoming><bpmn:outgoing>T20</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="Task_Contract" name="Generar contrato y registrar pagos"><bpmn:incoming>T20</bpmn:incoming><bpmn:incoming>T26</bpmn:incoming><bpmn:outgoing>T21</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="Gateway_Cancel" name="¿Solicita cancelar reserva?"><bpmn:incoming>T21</bpmn:incoming><bpmn:outgoing>T22</bpmn:outgoing><bpmn:outgoing>T23</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="Task_Coord" name="Coordinar proveedor, personal, especificaciones y cambios"><bpmn:incoming>T23</bpmn:incoming><bpmn:outgoing>T24</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="Gateway_Change" name="¿Solicita cambios?"><bpmn:incoming>T24</bpmn:incoming><bpmn:outgoing>T25</bpmn:outgoing><bpmn:outgoing>T27</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="Task_Change" name="Registrar cambio, nueva versión y aprobación; actualizar contrato"><bpmn:incoming>T25</bpmn:incoming><bpmn:outgoing>T26</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="End_Evento" name="Evento ejecutado"><bpmn:incoming>T27</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="Task_Cancel" name="Registrar cancelación, revisar contrato y devolución autorizada"><bpmn:incoming>T22</bpmn:incoming><bpmn:outgoing>T28</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="End_Cancel" name="Reserva cancelada"><bpmn:incoming>T28</bpmn:incoming></bpmn:endEvent>
  <bpmn:sequenceFlow id="T01" sourceRef="Start_Consulta" targetRef="Task_Lead"/>
<bpmn:sequenceFlow id="T02" sourceRef="Task_Lead" targetRef="Task_Cal"/>
<bpmn:sequenceFlow id="T03" sourceRef="Task_Cal" targetRef="Gateway_Fecha"/>
<bpmn:sequenceFlow id="T04" sourceRef="Gateway_Fecha" targetRef="Task_Alternativa" name="No"/>
<bpmn:sequenceFlow id="T05" sourceRef="Task_Alternativa" targetRef="Task_Cal"/>
<bpmn:sequenceFlow id="T06" sourceRef="Gateway_Fecha" targetRef="Gateway_DirectStart" name="Sí"/>
<bpmn:sequenceFlow id="T06a" sourceRef="Gateway_DirectStart" targetRef="Task_ConfigQuote" name="Cotización"/>
<bpmn:sequenceFlow id="T06b" sourceRef="Gateway_DirectStart" targetRef="Task_Deposit" name="Reserva directa (validar reglas)"/>
<bpmn:sequenceFlow id="T07" sourceRef="Task_ConfigQuote" targetRef="Task_Price"/>
<bpmn:sequenceFlow id="T08" sourceRef="Task_Price" targetRef="Task_Send"/>
<bpmn:sequenceFlow id="T09" sourceRef="Task_Send" targetRef="Task_Followup"/>
<bpmn:sequenceFlow id="T10" sourceRef="Task_Followup" targetRef="Task_Contact"/>
<bpmn:sequenceFlow id="T10a" sourceRef="Task_Contact" targetRef="Gateway_Race"/>
<bpmn:sequenceFlow id="T11" sourceRef="Gateway_Race" targetRef="Catch_Response"/>
<bpmn:sequenceFlow id="T12" sourceRef="Gateway_Race" targetRef="Catch_Expiry"/>
<bpmn:sequenceFlow id="T13" sourceRef="Catch_Expiry" targetRef="Task_Expire"/>
<bpmn:sequenceFlow id="T14" sourceRef="Task_Expire" targetRef="End_Expire"/>
<bpmn:sequenceFlow id="T15" sourceRef="Catch_Response" targetRef="Gateway_Accept"/>
<bpmn:sequenceFlow id="T16" sourceRef="Gateway_Accept" targetRef="Task_Deposit" name="Sí / negociación confirmada"/>
<bpmn:sequenceFlow id="T17" sourceRef="Gateway_Accept" targetRef="End_Expire" name="No / oportunidad cerrada"/>
<bpmn:sequenceFlow id="T18" sourceRef="Task_Deposit" targetRef="Task_Reserve"/>
<bpmn:sequenceFlow id="T20" sourceRef="Task_Reserve" targetRef="Task_Contract"/>
<bpmn:sequenceFlow id="T21" sourceRef="Task_Contract" targetRef="Gateway_Cancel"/>
<bpmn:sequenceFlow id="T22" sourceRef="Gateway_Cancel" targetRef="Task_Cancel" name="Sí"/>
<bpmn:sequenceFlow id="T23" sourceRef="Gateway_Cancel" targetRef="Task_Coord" name="No"/>
<bpmn:sequenceFlow id="T24" sourceRef="Task_Coord" targetRef="Gateway_Change"/>
<bpmn:sequenceFlow id="T25" sourceRef="Gateway_Change" targetRef="Task_Change" name="Sí"/>
<bpmn:sequenceFlow id="T26" sourceRef="Task_Change" targetRef="Task_Contract" name="Reemitir contrato"/>
<bpmn:sequenceFlow id="T27" sourceRef="Gateway_Change" targetRef="End_Evento" name="No"/>
<bpmn:sequenceFlow id="T28" sourceRef="Task_Cancel" targetRef="End_Cancel"/>
 </bpmn:process>
 <bpmndi:BPMNDiagram id="Diagram_Raices"><bpmndi:BPMNPlane id="Plane_Raices" bpmnElement="Process_Raices">
