<bpmndi:BPMNShape id="Shape_Gateway_Fecha" bpmnElement="Gateway_Fecha" isMarkerVisible="true"><dc:Bounds x="445" y="173" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_Task_Alternativa" bpmnElement="Task_Alternativa"><dc:Bounds x="525" y="55" width="140" height="60"/></bpmndi:BPMNShape>
