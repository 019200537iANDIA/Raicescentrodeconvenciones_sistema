<mxfile host="app.diagrams.net" modified="2026-11-15T00:00:00.000Z" agent="Codex" version="24.7.17"><diagram id="Proceso_AS_IS_Raices.drawio" name="AS-IS · Proceso actual"><mxGraphModel dx="1700" dy="825" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="825" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="head" value="AS-IS · Proceso actual" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#2c5f4a;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1600" height="50" as="geometry"/></mxCell><mxCell id="n0" value="Inicio: recibir consulta por WhatsApp, redes, llamada o presencial" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#d5eee1;strokeColor=#2c7a4b;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="240" height="85" as="geometry"/></mxCell><mxCell id="n1" value="Buscar fecha en calendarios físicos no sincronizados" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4ece7;strokeColor=#2c5f4a;" vertex="1" parent="1"><mxGeometry x="365" y="115" width="240" height="85" as="geometry"/></mxCell><mxCell id="n2" value="¿Fecha disponible?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6a800;" vertex="1" parent="1"><mxGeometry x="680" y="115" width="240" height="75" as="geometry"/></mxCell><mxCell id="n3" value="Conversar fecha alternativa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4ece7;strokeColor=#2c5f4a;" vertex="1" parent="1"><mxGeometry x="995" y="115" width="240" height="85" as="geometry"/></mxCell><mxCell id="n4" value="Consultar precios en Excel, mensajes o cuaderno" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4ece7;strokeColor=#2c5f4a;" vertex="1" parent="1"><mxGeometry x="1310" y="115" width="240" height="85" as="geometry"/></mxCell><mxCell id="n5" value="Preparar cotización con generador HTML o papel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4ece7;strokeColor=#2c5f4a;" vertex="1" parent="1"><mxGeometry x="50" y="290" width="240" height="85" as="geometry"/></mxCell><mxCell id="n6" value="Guardar PDF en Drive y enviarlo al cliente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4ece7;strokeColor=#2c5f4a;" vertex="1" parent="1"><mxGeometry x="365" y="290" width="240" height="85" as="geometry"/></mxCell><mxCell id="n7" value="¿Cliente acepta/separa?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6a800;" vertex="1" parent="1"><mxGeometry x="680" y="290" width="240" height="75" as="geometry"/></mxCell><mxCell id="n8" value="Negociar adelanto; completar contrato en papel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4ece7;strokeColor=#2c5f4a;" vertex="1" parent="1"><mxGeometry x="995" y="290" width="240" height="85" as="geometry"/></mxCell><mxCell id="n9" value="No existe registro sistemático de seguimiento" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4ece7;strokeColor=#2c5f4a;" vertex="1" parent="1"><mxGeometry x="1310" y="290" width="240" height="85" as="geometry"/></mxCell><mxCell id="n10" value="Anotar pago y reserva en cuaderno/calendario físico" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4ece7;strokeColor=#2c5f4a;" vertex="1" parent="1"><mxGeometry x="50" y="465" width="240" height="85" as="geometry"/></mxCell><mxCell id="n11" value="Coordinar con cliente, proveedores y personal por llamadas/reuniones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4ece7;strokeColor=#2c5f4a;" vertex="1" parent="1"><mxGeometry x="365" y="465" width="240" height="85" as="geometry"/></mxCell><mxCell id="n12" value="Fin: evento atendido" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#d5eee1;strokeColor=#2c7a4b;" vertex="1" parent="1"><mxGeometry x="680" y="465" width="240" height="85" as="geometry"/></mxCell><mxCell id="n13" value="Oportunidad pendiente" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#d5eee1;strokeColor=#2c7a4b;" vertex="1" parent="1"><mxGeometry x="995" y="465" width="240" height="85" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526b60;fontSize=11;" edge="1" parent="1" source="n0" target="n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526b60;fontSize=11;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526b60;fontSize=11;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526b60;fontSize=11;" edge="1" parent="1" source="n2" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526b60;fontSize=11;" edge="1" parent="1" source="n3" target="n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526b60;fontSize=11;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526b60;fontSize=11;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526b60;fontSize=11;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526b60;fontSize=11;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="No / no responde" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526b60;fontSize=11;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526b60;fontSize=11;" edge="1" parent="1" source="n8" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526b60;fontSize=11;" edge="1" parent="1" source="n9" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526b60;fontSize=11;" edge="1" parent="1" source="n10" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526b60;fontSize=11;" edge="1" parent="1" source="n11" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note0" value="Puntos de dolor medidos: 19 min para buscar en cuaderno; 11 min para cotizar (una observación); 25 min para reserva (dato reportado); 70 min de coordinación (dato reportado). No son promedios comparables." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6a800;fontSize=12;" vertex="1" parent="1"><mxGeometry x="55" y="655" width="470" height="125" as="geometry"/></mxCell><mxCell id="note1" value="No hay seguimiento sistemático cuando el cliente no acepta o no responde. Reserva directa y fecha alternativa quedan como variantes por validar con los responsables." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6a800;fontSize=12;" vertex="1" parent="1"><mxGeometry x="565" y="655" width="470" height="125" as="geometry"/></mxCell><mxCell id="note2" value="Fuentes dispersas: generador HTML, Drive, Excel, cuaderno, WhatsApp y calendarios. Este flujo es el canónico preliminar; confirmar con la gerente." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6a800;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1075" y="655" width="470" height="125" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>