<mxfile host="app.diagrams.net" modified="2026-11-15T00:00:00.000Z" agent="Codex" version="24.7.17"><diagram id="Proceso_TO_BE_Raices.drawio" name="TO-BE · Proceso propuesto"><mxGraphModel dx="1700" dy="1175" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1175" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="head" value="TO-BE · Proceso propuesto" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#2c5f4a;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1600" height="50" as="geometry"/></mxCell><mxCell id="n0" value="Inicio: consulta" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#d5eee1;strokeColor=#2c7a4b;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="240" height="85" as="geometry"/></mxCell><mxCell id="n1" value="Registrar/actualizar cliente, canal y oportunidad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4ece7;strokeColor=#2c5f4a;" vertex="1" parent="1"><mxGeometry x="365" y="115" width="240" height="85" as="geometry"/></mxCell><mxCell id="n2" value="Consultar disponibilidad; v1 permite una sola reserva por fecha" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4ece7;strokeColor=#2c5f4a;" vertex="1" parent="1"><mxGeometry x="680" y="115" width="240" height="85" as="geometry"/></mxCell><mxCell id="n3" value="¿Fecha disponible?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6a800;" vertex="1" parent="1"><mxGeometry x="995" y="115" width="240" height="75" as="geometry"/></mxCell><mxCell id="n4" value="Proponer fecha alternativa y volver a consultar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4ece7;strokeColor=#2c5f4a;" vertex="1" parent="1"><mxGeometry x="1310" y="115" width="240" height="85" as="geometry"/></mxCell><mxCell id="n5" value="Configurar tipo de evento, asistentes, paquete y servicios" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4ece7;strokeColor=#2c5f4a;" vertex="1" parent="1"><mxGeometry x="50" y="290" width="240" height="85" as="geometry"/></mxCell><mxCell id="n6" value="Calcular precio según reglas configurables y emitir cotización" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4ece7;strokeColor=#2c5f4a;" vertex="1" parent="1"><mxGeometry x="365" y="290" width="240" height="85" as="geometry"/></mxCell><mxCell id="n7" value="Enviar cotización; contactar a los 2–3 días; registrar respuesta y segundo contacto si hace falta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4ece7;strokeColor=#2c5f4a;" vertex="1" parent="1"><mxGeometry x="680" y="290" width="240" height="85" as="geometry"/></mxCell><mxCell id="n8" value="Esperar respuesta del cliente o vencimiento a los 15 días" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6a800;" vertex="1" parent="1"><mxGeometry x="995" y="290" width="240" height="75" as="geometry"/></mxCell><mxCell id="n9" value="Registrar respuesta; ¿acepta?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6a800;" vertex="1" parent="1"><mxGeometry x="1310" y="290" width="240" height="75" as="geometry"/></mxCell><mxCell id="n10" value="Cerrar oportunidad y liberar fecha si no pagó adelanto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4ece7;strokeColor=#2c5f4a;" vertex="1" parent="1"><mxGeometry x="50" y="465" width="240" height="85" as="geometry"/></mxCell><mxCell id="n11" value="Registrar adelanto acordado entre 10 % y 30 %" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4ece7;strokeColor=#2c5f4a;" vertex="1" parent="1"><mxGeometry x="365" y="465" width="240" height="85" as="geometry"/></mxCell><mxCell id="n12" value="Registrar reserva y bloquear fecha; máximo una por fecha en v1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4ece7;strokeColor=#2c5f4a;" vertex="1" parent="1"><mxGeometry x="680" y="465" width="240" height="85" as="geometry"/></mxCell><mxCell id="n13" value="Generar contrato y registrar pagos/cuotas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4ece7;strokeColor=#2c5f4a;" vertex="1" parent="1"><mxGeometry x="995" y="465" width="240" height="85" as="geometry"/></mxCell><mxCell id="n14" value="Coordinar asignaciones separadas de proveedor y personal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4ece7;strokeColor=#2c5f4a;" vertex="1" parent="1"><mxGeometry x="1310" y="465" width="240" height="85" as="geometry"/></mxCell><mxCell id="n15" value="¿Hay cambio solicitado?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6a800;" vertex="1" parent="1"><mxGeometry x="50" y="640" width="240" height="75" as="geometry"/></mxCell><mxCell id="n16" value="Registrar cancelación y evaluar devolución según contrato" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4ece7;strokeColor=#2c5f4a;" vertex="1" parent="1"><mxGeometry x="365" y="640" width="240" height="85" as="geometry"/></mxCell><mxCell id="n17" value="Registrar especificaciones y fechas límite de pedidos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4ece7;strokeColor=#2c5f4a;" vertex="1" parent="1"><mxGeometry x="680" y="640" width="240" height="85" as="geometry"/></mxCell><mxCell id="n18" value="Registrar nueva versión, aprobación y actualizar contrato" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4ece7;strokeColor=#2c5f4a;" vertex="1" parent="1"><mxGeometry x="995" y="640" width="240" height="85" as="geometry"/></mxCell><mxCell id="n19" value="Fin: evento atendido" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#d5eee1;strokeColor=#2c7a4b;" vertex="1" parent="1"><mxGeometry x="1310" y="640" width="240" height="85" as="geometry"/></mxCell><mxCell id="n20" value="Fin: oportunidad vencida/cerrada" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#d5eee1;strokeColor=#2c7a4b;" vertex="1" parent="1"><mxGeometry x="50" y="815" width="240" height="85" as="geometry"/></mxCell><mxCell id="n21" value="Fin: reserva cancelada" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#d5eee1;strokeColor=#2c7a4b;" vertex="1" parent="1"><mxGeometry x="365" y="815" width="240" height="85" as="geometry"/></mxCell><mxCell id="n22" value="¿Reserva directa?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6a800;" vertex="1" parent="1"><mxGeometry x="680" y="815" width="240" height="75" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526b60;fontSize=11;" edge="1" parent="1" source="n0" target="n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526b60;fontSize=11;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526b60;fontSize=11;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526b60;fontSize=11;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526b60;fontSize=11;" edge="1" parent="1" source="n3" target="n22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526b60;fontSize=11;" edge="1" parent="1" source="n4" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCel