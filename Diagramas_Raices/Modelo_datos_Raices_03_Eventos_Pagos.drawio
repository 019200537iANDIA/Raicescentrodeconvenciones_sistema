<mxfile host="app.diagrams.net" modified="2026-11-15T00:00:00.000Z" agent="Codex" version="24.7.17"><diagram id="Modelo_datos_Raices_03_Eventos_Pagos.drawio" name="Modelo de datos · eventos y pagos"><mxGraphModel dx="1750" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="e_title" value="&lt;b&gt;MODELO LÓGICO · EJECUCIÓN, PAGOS Y TRAZABILIDAD&lt;/b&gt;&lt;br&gt;Una reserva se transforma en un evento operativo con responsabilidades y documentos" style="text;html=1;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#2c5f4a;" vertex="1" parent="1"><mxGeometry x="390" y="25" width="1000" height="55" as="geometry"/></mxCell><mxCell id="e_event" value="&lt;b&gt;EVENTO / RESERVA&lt;/b&gt;&lt;br&gt;PK evento_id · FK cliente_id&lt;br&gt;fecha/hora · tipo · ambiente_config_id&lt;br&gt;estado / origen: cotización o directo&lt;br&gt;contrato vigente / notas operativas" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="45" y="120" width="270" height="165" as="geometry"/></mxCell><mxCell id="e_contract" value="&lt;b&gt;CONTRATO / VERSIÓN&lt;/b&gt;&lt;br&gt;PK contrato_id · FK evento_id&lt;br&gt;número de versión · fecha · estado&lt;br&gt;PDF/ruta · total y condiciones snapshot&lt;br&gt;cambios aprobados y firma" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="120" width="280" height="165" as="geometry"/></mxCell><mxCell id="e_pay" value="&lt;b&gt;PAGO / MOVIMIENTO&lt;/b&gt;&lt;br&gt;PK pago_id · FK evento_id&lt;br&gt;monto · fecha · método&lt;br&gt;tipo: adelanto/cuota/saldo/devolución&lt;br&gt;comprobante/ruta · registrado_por&lt;br&gt;anulado o reversado, sin borrar historia" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="745" y="120" width="290" height="180" as="geometry"/></mxCell><mxCell id="e_install" value="&lt;b&gt;CALENDARIO DE CUOTAS&lt;/b&gt;&lt;br&gt;PK cuota_id · FK evento_id&lt;br&gt;fecha límite · monto acordado&lt;br&gt;estado · pagado_en · pago_id&lt;br&gt;renegociación / nota" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1110" y="120" width="275" height="155" as="geometry"/></mxCell><mxCell id="e_supplier" value="&lt;b&gt;PROVEEDOR&lt;/b&gt;&lt;br&gt;PK proveedor_id · nombre&lt;br&gt;tipo de producto/servicio&lt;br&gt;contacto · activo" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="45" y="410" width="270" height="135" as="geometry"/></mxCell><mxCell id="e_supplier_assign" value="&lt;b&gt;ASIGNACIÓN DE PROVEEDOR&lt;/b&gt;&lt;br&gt;PK asignación_id · FK evento_id/proveedor_id&lt;br&gt;pedido/especificación (color, piezas, etc.)&lt;br&gt;cantidad · fecha límite de pedido&lt;br&gt;horario de entrega/trabajo · cambio/autor&lt;br&gt;estado y responsable interno" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="410" width="280" height="190" as="geometry"/></mxCell><mxCell id="e_staff" value="&lt;b&gt;PERSONAL&lt;/b&gt;&lt;br&gt;PK personal_id · nombre&lt;br&gt;rol: mozo/seguridad/limpieza/MC/otro&lt;br&gt;contacto · activo" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="745" y="410" width="290" height="135" as="geometry"/></mxCell><mxCell id="e_staff_assign" value="&lt;b&gt;ASIGNACIÓN DE PERSONAL&lt;/b&gt;&lt;br&gt;PK asignación_id · FK evento_id/personal_id&lt;br&gt;personal asignado y función del evento&lt;br&gt;sin turnos/horas/pagos en v1&lt;br&gt;reemplazos y control laboral: fase posterior" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1110" y="410" width="275" height="165" as="geometry"/></mxCell><mxCell id="e_task" value="&lt;b&gt;TAREA DEL EVENTO&lt;/b&gt;&lt;br&gt;PK tarea_id · FK evento_id&lt;br&gt;tipo: preparación/pedido/cambio&lt;br&gt;detalle · responsable · fecha límite&lt;br&gt;estado · evidencia / completada_en" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="45" y="700" width="270" height="155" as="geometry"/></mxCell><mxCell id="e_audit" value="&lt;b&gt;AUDITORÍA DE CAMBIOS&lt;/b&gt;&lt;br&gt;PK auditoría_id · usuario_id&lt;br&gt;entidad/registro/campo&lt;br&gt;valor anterior/nuevo · fecha&lt;br&gt;motivo · aprobador&lt;br&gt;cambios de precio, reserva, contrato" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="700" width="280" height="170" as="geometry"/></mxCell><mxCell id="e_refund" value="&lt;b&gt;CANCELACIÓN / DEVOLUCIÓN&lt;/b&gt;&lt;br&gt;PK cancelación_id · FK evento_id&lt;br&gt;solicitado_en · motivo/estado&lt;br&gt;monto aprobado · aprobado_por&lt;br&gt;FK pago_devolución nullable&lt;br&gt;condición ligada al contrato" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="745" y="700" width="290" height="170" as="geometry"/></mxCell><mxCell id="e_future" value="&lt;b&gt;FASE POSTERIOR / CATÁLOGO&lt;/b&gt;&lt;br&gt;INVENTARIO: artículo, variante/color, cantidad, movimiento/daño&lt;br&gt;GALERÍA: servicio/foto/orden/activo&lt;br&gt;Control de turnos, horas, pagos y adelantos&lt;br&gt;No mezclar con v1 hasta definir alcance" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6a800;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1110" y="700" width="520" height="170" as="geometry"/></mxCell><mxCell id="er1" value="1 : N versiones" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="e_event" target="e_contract"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="er2" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="e_event" target="e_pay"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="er3" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="e_event" target="e_install"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="er4" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="e_event" target="e_supplier_assign"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="er5" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="e_supplier" target="e_supplier_assign"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="er6" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="e_event" target="e_staff_assign"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="er7" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="e_staff" target="e_staff_assign"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="er8" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="e_event" target="e_task"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="er9" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="e_event" target="e_audit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="er10" value="0 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="e_event" target="e_refund"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_note" value="&lt;b&gt;NOTA&lt;/b&gt;&lt;br&gt;Decisión de diseño: no eliminar físicamente registros de negocio; conservar anulación y trazabilidad. U1 y el Doc. 3 asignan eliminación a ambos roles, así que la interfaz puede ofrecer eliminación lógica a ambos, registrando usuario y motivo. Política de retención por acordar." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6a800;fontSize=11;" vertex="1" parent="1"><mxGeometry x="45" y="940" width="790" height="85" as="geometry"/></mxCell><mxCell id="e_note2" value="&lt;b&gt;NOTA&lt;/b&gt;&lt;br&gt;Datos personales confirmados: nombre, celular, dirección y DNI. Dirección permite identificar distrito de residencia/descuento; DNI sirve para corroborar datos. Aplicar acceso restringido y definir conservación/eliminación segura." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6a800;fontSize=11;" vertex="1" parent="1"><mxGeometry x="875" y="940" width="790" height="85" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>