ell><mxCell id="a8" value="respaldo y trazabilidad" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526b60;fontSize=11;" edge="1" parent="1" source="backupaudit" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Tecnologías propuestas por el Word: PHP/Laravel, Filament y MySQL. Esta arquitectura es un diseño preliminar, no una implementación verificada. El diseño final debe respetar la conectividad disponible y la política de datos acordada." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fce4d6;strokeColor=#b4532a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="850" width="850" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>