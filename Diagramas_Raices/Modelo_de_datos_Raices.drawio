<mxfile host="app.diagrams.net" modified="2026-11-15T00:00:00.000Z" agent="Codex" version="24.7.17"><diagram id="Modelo_de_datos_Raices.drawio" name="Modelo de datos · comercial"><mxGraphModel dx="1750" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c_title" value="&lt;b&gt;MODELO LÓGICO · COMERCIAL Y COTIZACIONES&lt;/b&gt;&lt;br&gt;V2 · Separar oportunidad, cotización, versiones y evento/reserva" style="text;html=1;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#2c5f4a;" vertex="1" parent="1"><mxGeometry x="380" y="25" width="950" height="55" as="geometry"/></mxCell><mxCell id="c_client" value="&lt;b&gt;CLIENTE&lt;/b&gt;&lt;br&gt;PK cliente_id&lt;br&gt;nombre_completo · celular (búsqueda repetidos)&lt;br&gt;DNI · dirección · distrito/residencia&lt;br&gt;uso: validar identidad y residencia/descuento&lt;br&gt;acceso restringido; retención por definir&lt;br&gt;tipo_cliente: nuevo / recurrente" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="45" y="120" width="270" height="190" as="geometry"/></mxCell><mxCell id="c_lead" value="&lt;b&gt;CONSULTA / OPORTUNIDAD&lt;/b&gt;&lt;br&gt;PK consulta_id · FK cliente_id&lt;br&gt;canal · fecha · tipo_evento_id&lt;br&gt;resumen de necesidad / presupuesto&lt;br&gt;estado · responsable_id" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="120" width="270" height="165" as="geometry"/></mxCell><mxCell id="c_touch" value="&lt;b&gt;INTERACCIÓN / SEGUIMIENTO&lt;/b&gt;&lt;br&gt;PK interaccion_id · FK consulta_id&lt;br&gt;usuario_id · fecha · canal&lt;br&gt;resultado: pendiente/acepta/rechaza&lt;br&gt;próxima acción / fecha recordatorio&lt;br&gt;ultimátum y respuesta registrada" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="735" y="120" width="280" height="180" as="geometry"/></mxCell><mxCell id="c_quote" value="&lt;b&gt;COTIZACIÓN&lt;/b&gt;&lt;br&gt;PK cotizacion_id · FK consulta_id&lt;br&gt;cotizacion_padre_id (alternativas)&lt;br&gt;fecha_evento · adultos · niños&lt;br&gt;ambiente_config_id · total&lt;br&gt;vigencia: 15 días&lt;br&gt;estado / creado_por" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="405" width="270" height="175" as="geometry"/></mxCell><mxCell id="c_version" value="&lt;b&gt;VERSIÓN DE COTIZACIÓN&lt;/b&gt;&lt;br&gt;PK version_id · FK cotizacion_id&lt;br&gt;número · fecha · autor&lt;br&gt;motivo / aceptación del cliente&lt;br&gt;subtotal · descuento · total congelados&lt;br&gt;PDF/contrato emitido y hash/ruta" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="735" y="405" width="280" height="170" as="geometry"/></mxCell><mxCell id="c_line" value="&lt;b&gt;LÍNEA DE VERSIÓN&lt;/b&gt;&lt;br&gt;PK linea_id · FK version_id&lt;br&gt;FK servicio_id&lt;br&gt;descripción_snapshot · cantidad&lt;br&gt;precio interno · subtotal · descuento&lt;br&gt;mostrar cantidad; ocultar precio unitario" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1090" y="405" width="285" height="175" as="geometry"/></mxCell><mxCell id="c_service" value="&lt;b&gt;SERVICIO / PAQUETE&lt;/b&gt;&lt;br&gt;PK servicio_id · nombre comercial&lt;br&gt;paquetes: básico / estándar / premium&lt;br&gt;componentes del paquete por versión&lt;br&gt;precio no fijo: composición personalizada&lt;br&gt;categoría / descripción / activo" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1090" y="120" width="300" height="190" as="geometry"/></mxCell><mxCell id="c_type" value="&lt;b&gt;TIPO DE EVENTO&lt;/b&gt;&lt;br&gt;PK tipo_evento_id · nombre&lt;br&gt;matrimonio · 15 años · cumpleaños&lt;br&gt;graduación/promoción · corporativo · otro" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="45" y="405" width="270" height="145" as="geometry"/></mxCell><mxCell id="c_event" value="&lt;b&gt;EVENTO / RESERVA&lt;/b&gt;&lt;br&gt;PK evento_id · FK cliente_id&lt;br&gt;FK cotizacion_id/version_id nullable (reserva directa)&lt;br&gt;FK tipo_evento_id · fecha/hora&lt;br&gt;estado operativo / contrato vigente&lt;br&gt;nace de cotización o reserva directa" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1450" y="405" width="270" height="180" as="geometry"/></mxCell><mxCell id="cr1" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="c_client" target="c_lead"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cr2" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="c_lead" target="c_touch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cr3" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="c_lead" target="c_quote"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cr4" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="c_quote" target="c_version"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cr5" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="c_version" target="c_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cr6" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="c_service" target="c_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cr7" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="c_client" target="c_event"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cr8" value="0..1 : 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="c_version" target="c_event"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cr9" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="c_type" target="c_lead"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cr10" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="c_type" target="c_event"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c_note" value="&lt;b&gt;NOTA&lt;/b&gt;&lt;br&gt;El cliente puede volver por la misma cotización con otro paquete: crear alternativa o nueva versión vinculada; conservar versiones anteriores para historial. No sobrescribir precios/servicios ya enviados. Reserva directa permite evento sin cotización." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6a800;fontSize=11;" vertex="1" parent="1"><mxGeometry x="45" y="700" width="790" height="100" as="geometry"/></mxCell><mxCell id="c_note2" value="&lt;b&gt;NOTA&lt;/b&gt;&lt;br&gt;Los precios unitarios se guardan para cálculo interno. El PDF para cliente muestra descripción, cantidades y total/por persona según regla aprobada, pero no el precio por producto." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6a800;fontSize=11;" vertex="1" parent="1"><mxGeometry x="875" y="700" width="790" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>