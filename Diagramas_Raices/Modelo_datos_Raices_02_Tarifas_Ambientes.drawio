<mxfile host="app.diagrams.net" modified="2026-11-15T00:00:00.000Z" agent="Codex" version="24.7.17"><diagram id="Modelo_datos_Raices_02_Tarifas_Ambientes.drawio" name="Modelo de datos · tarifas y ambientes"><mxGraphModel dx="1750" dy="910" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="910" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p_title" value="&lt;b&gt;MODELO LÓGICO · TARIFAS, DESCUENTOS Y AMBIENTES&lt;/b&gt;&lt;br&gt;Políticas configurables, con vigencia y autorización" style="text;html=1;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#2c5f4a;" vertex="1" parent="1"><mxGeometry x="390" y="25" width="950" height="55" as="geometry"/></mxCell><mxCell id="p_service" value="&lt;b&gt;SERVICIO / PAQUETE&lt;/b&gt;&lt;br&gt;PK servicio_id · categoría&lt;br&gt;componentes / unidad de medida&lt;br&gt;activo · nombre comercial" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="45" y="120" width="245" height="135" as="geometry"/></mxCell><mxCell id="p_price" value="&lt;b&gt;TARIFA BASE HISTÓRICA&lt;/b&gt;&lt;br&gt;PK tarifa_id · FK servicio_id&lt;br&gt;precio · moneda por confirmar&lt;br&gt;válida_desde / hasta · autor&lt;br&gt;no asumir precio fijo por paquete" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="365" y="120" width="265" height="155" as="geometry"/></mxCell><mxCell id="p_rule" value="&lt;b&gt;REGLA DE TARIFA&lt;/b&gt;&lt;br&gt;PK regla_id · tipo y prioridad&lt;br&gt;temporada (altas/bajas por definir)&lt;br&gt;día de semana / horario día-noche&lt;br&gt;rango de asistentes · adultos/niños&lt;br&gt;residencia/distrito · promoción L–J 20–30 % (confirmar)&lt;br&gt;vigencia · activa · condiciones" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="705" y="120" width="295" height="220" as="geometry"/></mxCell><mxCell id="p_adj" value="&lt;b&gt;AJUSTE / DESCUENTO APLICADO&lt;/b&gt;&lt;br&gt;PK ajuste_id · FK version_id&lt;br&gt;FK regla_id nullable · monto/%&lt;br&gt;motivo conversado y cálculo resultante&lt;br&gt;autorizado_por (propietario/gerente)&lt;br&gt;fecha · compatibilidad con otras reglas" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="120" width="300" height="185" as="geometry"/></mxCell><mxCell id="p_param" value="&lt;b&gt;PARÁMETRO DE NEGOCIO&lt;/b&gt;&lt;br&gt;PK parámetro_id · clave/valor&lt;br&gt;cotización: 15 días&lt;br&gt;adelanto permitido: 10–30 %&lt;br&gt;liberar fecha al vencer sin adelanto&lt;br&gt;un evento por fecha en la v1&lt;br&gt;historial: autor, vigencia y aprobador" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1450" y="120" width="270" height="205" as="geometry"/></mxCell><mxCell id="p_venue" value="&lt;b&gt;AMBIENTE / RECURSO&lt;/b&gt;&lt;br&gt;PK ambiente_id · nombre&lt;br&gt;área verde · salón principal&lt;br&gt;mezanine · salón divisible (segmentos)&lt;br&gt;capacidad y acceso/restricciones" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="45" y="430" width="245" height="155" as="geometry"/></mxCell><mxCell id="p_combo" value="&lt;b&gt;CONFIGURACIÓN DE AMBIENTES&lt;/b&gt;&lt;br&gt;PK config_id · nombre&lt;br&gt;ambientes incluidos (tabla puente)&lt;br&gt;área verde + salón completo&lt;br&gt;área verde + salón + mezanine&lt;br&gt;área verde + medio salón / área verde sola&lt;br&gt;validar compatibilidad y capacidad" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="365" y="430" width="265" height="195" as="geometry"/></mxCell><mxCell id="p_policy" value="&lt;b&gt;POLÍTICA DE DISPONIBILIDAD&lt;/b&gt;&lt;br&gt;PK policy_id · vigencia del modo&lt;br&gt;V1: máximo 1 reserva por fecha&lt;br&gt;bloqueo completo de la fecha reservada&lt;br&gt;salón divisible no habilita 2 eventos en v1&lt;br&gt;escalamiento futuro requiere nueva política&lt;br&gt;ambientes elegidos se conservan por evento" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="705" y="430" width="295" height="195" as="geometry"/></mxCell><mxCell id="p_slot" value="&lt;b&gt;BLOQUEO / RESERVA DE RECURSO&lt;/b&gt;&lt;br&gt;PK bloqueo_id · FK evento_id&lt;br&gt;FK config_id / ambiente_id&lt;br&gt;fecha / estado disponible o reservada&lt;br&gt;adelanto acordado: 10–30 %&lt;br&gt;sin adelanto al día 15: liberar fecha&lt;br&gt;bloqueado_desde / vence / liberado_en" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="430" width="300" height="195" as="geometry"/></mxCell><mxCell id="p_adults" value="&lt;b&gt;CANTIDAD / PRECIO POR PERSONA&lt;/b&gt;&lt;br&gt;por versión: adultos y niños separados&lt;br&gt;tabla de tarifa por grupo etario (definir edades)&lt;br&gt;regla para costo por cantidad de asistentes&lt;br&gt;total y precio promedio/persona" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#f8fbf8;strokeColor=#2c5f4a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1450" y="430" width="270" height="160" as="geometry"/></mxCell><mxCell id="pr1" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="p_service" target="p_price"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pr2" value="aplica a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="p_service" target="p_rule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pr3" value="0 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="p_rule" target="p_adj"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pr4" value="N : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="p_venue" target="p_combo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pr5" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="p_combo" target="p_slot"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pr6" value="controla" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERoneToMany;startArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#526b60;fontSize=10;" edge="1" parent="1" source="p_policy" target="p_slot"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p_note" value="&lt;b&gt;NOTA&lt;/b&gt;&lt;br&gt;Regla confirmada por el investigador: adelanto entre 10 % y 30 % para captar clientes en esta etapa. Guardar el importe acordado en cada cotización. El permiso para autorizar una excepción fuera de ese rango aún no está definido." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6a800;fontSize=11;" vertex="1" parent="1"><mxGeometry x="45" y="760" width="790" height="105" as="geometry"/></mxCell><mxCell id="p_note2" value="&lt;b&gt;NOTA&lt;/b&gt;&lt;br&gt;Regla confirmada: cotización válida por 15 días; si no se paga el adelanto en ese plazo, la oportunidad vence y la fecha se libera. V1 permite una reserva por fecha; eventos simultáneos al dividir ambientes quedan para una futura ampliación." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6a800;fontSize=11;" vertex="1" parent="1"><mxGeometry x="875" y="760" width="790" height="105" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>